{
  "name": "aracnoif",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend --",
    "build": "npm run build --workspace frontend -- --outDir ../dist --emptyOutDir",
    "preview": "npm run preview --workspace frontend -- --outDir ../dist",
    "test": "npm run test --workspace frontend",
    "check:ui": "npm run check:ui --workspace frontend",
    "test:backend": "python -m pytest -q backend/tests",
    "check:backend": "python -m compileall -q backend && ruff check backend",
    "check:all": "npm run build && npm test && npm run check:ui && npm run test:backend && npm run check:backend"
  }
}
